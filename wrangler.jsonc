{
  "name": "jeopardy-lm",
  "compatibility_date": "2025-04-01",
  "main": "src/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_STORE",
        "class_name": "UserStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "user-store-v1",
      "new_sqlite_classes": ["UserStore"]
    }
  ]
}
